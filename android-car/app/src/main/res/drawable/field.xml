<?xml version="1.0" encoding="utf-8"?>
<!-- Text field: a filled tile; the accent outline shows which field is being typed in. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true"><shape><solid android:color="@color/surface2" /><corners android:radius="10dp" /><stroke android:width="1dp" android:color="@color/accent" /></shape></item>
    <item><shape><solid android:color="@color/surface2" /><corners android:radius="10dp" /></shape></item>
</selector>
