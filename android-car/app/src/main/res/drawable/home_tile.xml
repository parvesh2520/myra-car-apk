<?xml version="1.0" encoding="utf-8"?>
<!-- Myra UI .tile / .icon-btn: surface-2, lighter when pressed. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><solid android:color="@color/home_surface3" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/home_line" /></shape></item>
    <item><shape><solid android:color="@color/home_surface2" /><corners android:radius="14dp" /><stroke android:width="1dp" android:color="@color/home_line" /></shape></item>
</selector>
