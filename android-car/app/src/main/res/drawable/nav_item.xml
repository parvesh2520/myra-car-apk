<?xml version="1.0" encoding="utf-8"?>
<!-- Rail entry: the open screen sits on a rounded tile, like a head unit's app rail. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true"><inset android:insetLeft="10dp" android:insetRight="10dp"><shape><solid android:color="@color/surface2" /><corners android:radius="14dp" /></shape></inset></item>
    <item android:state_pressed="true"><inset android:insetLeft="10dp" android:insetRight="10dp"><shape><solid android:color="@color/surface" /><corners android:radius="14dp" /></shape></inset></item>
    <item><shape><solid android:color="#00000000" /></shape></item>
</selector>
