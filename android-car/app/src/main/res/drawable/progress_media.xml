<?xml version="1.0" encoding="utf-8"?>
<!-- Track progress: white fill on the hairline colour; the accent stays for the mic and the route. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background"><shape><solid android:color="@color/line" /><corners android:radius="2dp" /></shape></item>
    <item android:id="@android:id/progress"><clip><shape><solid android:color="@color/ink" /><corners android:radius="2dp" /></shape></clip></item>
</layer-list>
