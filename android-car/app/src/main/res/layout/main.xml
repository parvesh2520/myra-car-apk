<?xml version="1.0" encoding="utf-8"?>
<!-- Home, laid out like the Myra UI home: a welcome banner with weather and a "Try saying" card on top,
     then rounded cards: navigation on the left; now playing and Myra stacked on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/home_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Welcome banner -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="Welcome"
                android:textColor="@color/home_ink"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/greetingSub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Welcome back"
                android:textColor="@color/home_ink2"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Weather at the car: Open-Meteo for the GPS position, area from OpenStreetMap. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/home_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cloud"
                android:tint="@color/home_warn" />

            <TextView
                android:id="@+id/weatherTemp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-medium"
                android:fontFeatureSettings="tnum"
                android:includeFontPadding="false"
                android:text="—°"
                android:textColor="@color/home_ink"
                android:textSize="22sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weatherSky"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:text="Weather"
                    android:textColor="@color/home_ink"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/weatherPlace"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:maxWidth="150dp"
                    android:text="Waiting for your location"
                    android:textColor="@color/home_ink2"
                    android:textSize="12sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/weatherRange"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/home_ink2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/weatherMore"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFeatureSettings="tnum"
                    android:maxLines="1"
                    android:textColor="@color/home_ink3"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Try saying: tapping it sends the phrase to Myra. -->
        <LinearLayout
            android:id="@+id/tryCard"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:background="@drawable/home_card_accent"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wave"
                android:tint="@color/home_accent" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Try saying"
                    android:textColor="@color/home_ink2"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tryText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="200dp"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- Navigation card: map on top, destination row below a hairline. Corners clipped in code. -->
        <LinearLayout
            android:id="@+id/navCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.1"
            android:background="@drawable/home_card"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <com.myra.car.HomeMap
                    android:id="@+id/map"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:background="@drawable/home_map_fade" />

                <TextView
                    style="@style/HomeLabel"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:text="NAVIGATION"
                    android:textColor="@color/home_ink2" />

                <!-- Quick destinations: filled in by MainActivity from Places.QUICK. -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="38dp"
                    android:layout_marginTop="40dp"
                    android:clipToPadding="false"
                    android:paddingStart="16dp"
                    android:paddingEnd="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/quickKeys"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:id="@+id/mapNote"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|start"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="88dp"
                    android:background="@drawable/home_map_note"
                    android:paddingStart="12dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="8dp"
                    android:text="Finding your location"
                    android:textColor="@color/home_ink2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/roadName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/home_map_note"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:maxWidth="320dp"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:textColor="@color/home_ink"
                    android:textSize="15sp"
                    android:visibility="gone" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:padding="4dp"
                    android:text="Esri, HERE, Garmin, © OpenStreetMap contributors"
                    android:textColor="@color/home_ink3"
                    android:textSize="9sp" />
            </FrameLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/home_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <FrameLayout
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/home_icon_soft">

                    <ImageView
                        android:id="@+id/navIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_nav"
                        android:tint="@color/home_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/navDest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:text="Where to?"
                        android:textColor="@color/home_ink"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/navSub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/home_ink2"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/saveHome"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/home_tile"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_home"
                    android:drawablePadding="8dp"
                    android:drawableTint="@color/home_accent"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:text="Set home"
                    android:textColor="@color/home_ink"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Now playing: label and volume on top; artwork, track and transport keys below. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/HomeLabel"
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="NOW PLAYING · BLUETOOTH" />

                    <ImageView
                        android:id="@+id/volumeDown"
                        style="@style/HomeIconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Volume down"
                        android:padding="12dp"
                        android:src="@drawable/ic_remove" />

                    <TextView
                        android:id="@+id/volumeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/ic_volume"
                        android:drawablePadding="4dp"
                        android:drawableTint="@color/home_ink3"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="52dp"
                        android:textColor="@color/home_ink"
                        android:textSize="13sp" />

                    <ImageView
                        android:id="@+id/volumeUp"
                        style="@style/HomeIconButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="Volume up"
                        android:padding="12dp"
                        android:src="@drawable/ic_add" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/mediaCover"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:background="@drawable/home_tile">

                        <ImageView
                            android:id="@+id/mediaArt"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_music"
                            android:tint="@color/home_ink3" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mediaState"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="Nothing playing"
                            android:textColor="@color/home_ink"
                            android:textSize="17sp" />

                        <TextView
                            android:id="@+id/mediaSub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="Bluetooth audio"
                            android:textColor="@color/home_ink2"
                            android:textSize="12sp" />

                        <!-- Track progress: shown while a demo track is loaded. -->
                        <LinearLayout
                            android:id="@+id/mediaProgressRow"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:visibility="gone">

                            <TextView
                                android:id="@+id/mediaElapsed"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:minWidth="28dp"
                                android:text="0:00"
                                android:textColor="@color/home_ink3"
                                android:textSize="10sp" />

                            <ProgressBar
                                android:id="@+id/mediaProgress"
                                style="@android:style/Widget.ProgressBar.Horizontal"
                                android:layout_width="0dp"
                                android:layout_height="4dp"
                                android:layout_marginStart="6dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:max="1000"
                                android:progressDrawable="@drawable/home_progress" />

                            <TextView
                                android:id="@+id/mediaTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFeatureSettings="tnum"
                                android:gravity="end"
                                android:minWidth="28dp"
                                android:text="0:00"
                                android:textColor="@color/home_ink3"
                                android:textSize="10sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/mediaPrev"
                        style="@style/HomeIconButton"
                        android:contentDescription="Previous track"
                        android:src="@drawable/ic_prev" />

                    <ImageView
                        android:id="@+id/mediaPlay"
                        android:layout_width="52dp"
                        android:layout_height="52dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/home_play"
                        android:clickable="true"
                        android:contentDescription="Play"
                        android:focusable="true"
                        android:padding="16dp"
                        android:src="@drawable/ic_play"
                        android:tint="@color/home_on_accent" />

                    <ImageView
                        android:id="@+id/mediaNext"
                        style="@style/HomeIconButton"
                        android:contentDescription="Next track"
                        android:src="@drawable/ic_next" />
                </LinearLayout>
            </LinearLayout>

            <!-- Myra -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:background="@drawable/home_card"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="52dp"
                        android:layout_height="52dp">

                        <View
                            android:id="@+id/micRing"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/mic_ring"
                            android:visibility="invisible" />

                        <ImageView
                            android:id="@+id/mic"
                            android:layout_width="44dp"
                            android:layout_height="44dp"
                            android:layout_gravity="center"
                            android:background="@drawable/mic_bg"
                            android:contentDescription="Hold to talk to Myra"
                            android:padding="12dp"
                            android:src="@drawable/ic_mic"
                            android:tint="@color/home_on_accent" />
                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/HomeLabel"
                            android:text="FOR YOU · MYRA" />

                        <TextView
                            android:id="@+id/status"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="2"
                            android:text="Hold the mic and speak"
                            android:textColor="@color/home_ink"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <Switch
                        android:id="@+id/speakReplies"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:layout_marginStart="8dp"
                        android:switchPadding="8dp"
                        android:text="Speak replies"
                        android:textColor="@color/home_ink2"
                        android:textSize="12sp" />
                </LinearLayout>

                <ScrollView
                    android:id="@+id/scroll"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:fadingEdgeLength="20dp"
                    android:requiresFadingEdge="vertical"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/log"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="8dp" />
                </ScrollView>

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fadingEdgeLength="24dp"
                    android:requiresFadingEdge="horizontal"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/chips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
