<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:paddingStart="24dp"
    android:paddingTop="20dp"
    android:paddingEnd="24dp"
    android:paddingBottom="20dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="2"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Shortcuts"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/shortcutSummary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink3"
            android:textSize="13sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/shortcutList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_weight="1"
        android:background="@drawable/panel"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Teach Myra a shortcut"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/ink"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="3dp"
            android:text="On Home, hold the mic and say a name and what it should do. Any language works."
            android:textColor="@color/ink2"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/tile"
            android:lineSpacingExtra="4dp"
            android:padding="12dp"
            android:text="“Whenever I say chill mode, set the AC to 20 and play music.”\n\n“जब भी मैं कहूँ movie night, volume कम करो और अगला गाना चलाओ”"
            android:textColor="@color/ink"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="Then just say “chill mode”. To remove one, say “delete the chill mode shortcut” or tap Delete."
            android:textColor="@color/ink3"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
