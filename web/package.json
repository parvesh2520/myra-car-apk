{
  "name": "myra-infotainment",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MYRA — smart infotainment system prototype for the Hyundai Verna",
  "scripts": {
    "dev": "vite",
    "dev:phone": "vite --mode phone",
    "build": "tsc -b && vite build",
    "build:car": "tsc -b && vite build --mode car",
    "preview": "vite preview",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.1.1",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "vite": "^7.3.7"
  }
}
